# Copy to .env and keep .env out of git. Never commit real secrets.

# SQLite database file, path is relative to prisma/ (design §1, §5)
DATABASE_URL="file:./dev.db"

# Secret for signing the session cookie (design rule 4).
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-random-hex-chars"
